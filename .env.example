# TEMM configuration example — copy to .env and fill in only what you need.
# Everything is optional: TEMM runs fully offline with local CLIs and Ollama,
# and provider keys can also be managed at runtime via Settings (stored in the
# encrypted local vault under AI_FLEET_DATA_DIR).

# Server bind address / port (defaults shown)
AI_FLEET_HOST=127.0.0.1
AI_FLEET_PORT=8787

# Set to 1 to disable the automatic browser launch on start
AI_FLEET_NO_BROWSER=

# Root directory for the local database, secret vault, and runtime data.
# Defaults to ~/.ai_fleet when unset.
AI_FLEET_DATA_DIR=

# ---- Provider API keys (optional; the local vault is preferred) ----------
# Any key below is read as a fallback when the vault has no stored value.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# Local Ollama endpoint (no key required)
OLLAMA_HOST=http://127.0.0.1:11434
